# Copy this file to .env and fill it in:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. NEVER commit it, paste it into an issue, or share it:
# the API key controls every light on your Govee account.
#
# beacon reads .env from the directory you run it in (handy when working from a
# checkout). Variables already set in your real environment win over this file,
# and empty values are ignored. Only the variables below are read; anything
# else in here is ignored. If you install beacon and run it from anywhere, put
# the key in ~/.config/beacon/config.toml (api_key = "...") instead.

# Your Govee API key. Get one in the Govee Home app:
# Profile -> Settings -> Apply for API Key (Govee emails it to you).
GOVEE_API_KEY=

# Optional: where beacon keeps its config and its state (state.json, logs).
# The defaults are fine; `beacon config path` shows the config location.
# BEACON_CONFIG=/home/you/.config/beacon/config.toml
# BEACON_STATE_DIR=/home/you/.local/state/beacon
