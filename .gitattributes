# Line endings: LF everywhere, so golden files, scripts and fixtures compare
# and run the same on every OS (Git on Windows would otherwise check them out
# with CRLF).
* text=auto eol=lf
*.golden text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
PKGBUILD text eol=lf
